# =====================================================
# SYNTAX Backend — Environment Variables
# Copy this to .env.local and fill in your own values
# =====================================================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase — get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_random_64_char_hex_string_here
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=generate_another_random_64_char_hex_string_here
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,https://your-production-domain.com

# Grok AI — get from https://console.x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE_MB=5

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=SYNTAX <noreply@syntax.com>
