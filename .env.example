# Environment variables for Render / production redeploy
# Copy each key into Render → Environment (or your host dashboard)

# --- Database (required for production persistence) ---
# Use a REAL Atlas URI (host like cluster0.xxxxx.mongodb.net — not "cluster.mongodb.net")
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/syntax?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/syntax?retryWrites=true&w=majority

# false = use MongoDB (recommended on Render)
# true  = local JSON files in .data/ (OK for local/dev only; data is lost on redeploy)
USE_FILE_DB=false

# --- Auth (required) ---
NEXTAUTH_SECRET=replace-with-long-random-secret
# Must match the live URL you open in the browser
# Local:  http://localhost:3000
# Render (this project): https://syntax-03.onrender.com
NEXTAUTH_URL=https://syntax-03.onrender.com

# Admin login
ADMIN_EMAIL=admin@syntaxsoftwaresolution.com
ADMIN_PASSWORD=change-this-password

# Optional
GEMINI_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

# Do NOT set PORT — Render sets it automatically
